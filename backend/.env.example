# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Credentials (PostgreSQL and Authentication)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# External Data Providers
# Data.gov.in / Agmarknet Mandi Price API
DATA_GOV_IN_API_KEY=your-data-gov-in-api-key
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Weather API (Open-Meteo requires no key; or WeatherAPI.com / IMD)
WEATHER_API_KEY=optional-weather-api-key
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Machine Learning Model Configuration
MODEL_DIR=models_storage
FORECAST_CONFIDENCE_INTERVAL=0.90

# Real Email OTP Configuration (Gmail App Password or SMTP Gateway)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-16-char-app-password
SMTP_FROM_NAME="KrishiSetu | कृषीसेतू"
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

# Real SMS Gateway Configuration
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_PHONE_NUMBER=your-twilio-phone
FAST2SMS_API_KEY=your-fast2sms-api-key

# OTP Simulation Mode (Set false for real OTP only)
ENABLE_OTP_SIMULATION=false
